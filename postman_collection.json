{
  "info": {
    "name": "NEXUS OPERA | ERP + CRM Operations Portal API Collection",
    "description": "Complete REST API collection for NEXUS OPERA Wholesale ERP + CRM System including Auth, Customer CRM, Products Catalog, Inventory Stock Adjustments, Sales Challans, and Dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nexusopera.com\",\n  \"password\": \"nexusAdmin123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Sales)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@nexusopera.com\",\n  \"password\": \"nexusSales123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Warehouse)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"warehouse@nexusopera.com\",\n  \"password\": \"nexusWarehouse123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Accounts)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"accounts@nexusopera.com\",\n  \"password\": \"nexusAccounts123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Customer CRM",
      "item": [
        {
          "name": "List Customers (Search & Filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/customers?search=Apex&page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["customers"], "query": [{"key":"search","value":"Apex"},{"key":"page","value":"1"},{"key":"limit","value":"10"}] }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vikram Sharma\",\n  \"mobile\": \"+91 98765 11111\",\n  \"email\": \"vikram@sharmatraders.com\",\n  \"business_name\": \"Sharma Wholesale Corp\",\n  \"gst_number\": \"27AAACS9999Z1\",\n  \"customer_type\": \"Wholesale\",\n  \"address\": \"77 Market Road, Mumbai\",\n  \"status\": \"Active\",\n  \"follow_up_date\": \"2026-08-25\",\n  \"notes\": \"Key wholesale distributor in western region.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
        }
      ]
    },
    {
      "name": "3. Products & Catalog",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        }
      ]
    },
    {
      "name": "4. Sales Challans",
      "item": [
        {
          "name": "Confirm Sales Challan (Transactional Stock Deduction)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/challans/:id/confirm", "host": ["{{baseUrl}}"], "path": ["challans", ":id", "confirm"] }
          }
        }
      ]
    }
  ]
}
