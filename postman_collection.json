{
  "info": {
    "name": "Mini ERP + CRM Operations Portal API Collection",
    "description": "Complete REST API collection for Mini ERP + CRM Operations Portal including Auth, Customer CRM, Products Catalog, Inventory Stock Adjustments, Sales Challans, and Dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@company.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Sales)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@company.com\",\n  \"password\": \"sales123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Warehouse)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"warehouse@company.com\",\n  \"password\": \"warehouse123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Accounts)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"accounts@company.com\",\n  \"password\": \"accounts123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Customer CRM",
      "item": [
        {
          "name": "List Customers (Search & Filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/customers?search=Apex&page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["customers"], "query": [{"key":"search","value":"Apex"},{"key":"page","value":"1"},{"key":"limit","value":"10"}] }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vikram Sharma\",\n  \"mobile\": \"+91 98765 11111\",\n  \"email\": \"vikram@sharmatraders.com\",\n  \"business_name\": \"Sharma Wholesale Corp\",\n  \"gst_number\": \"27AAACS9999Z1\",\n  \"customer_type\": \"Wholesale\",\n  \"address\": \"77 Market Road, Mumbai\",\n  \"status\": \"Active\",\n  \"follow_up_date\": \"2026-08-25\",\n  \"notes\": \"Key wholesale distributor in western region.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
        },
        {
          "name": "Get Customer Details by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/customers/:id", "host": ["{{baseUrl}}"], "path": ["customers", ":id"] }
          }
        },
        {
          "name": "Add Follow-Up Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Spoke with purchase manager regarding quarterly discount structure.\",\n  \"follow_up_date\": \"2026-09-01\",\n  \"status\": \"Active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers/:id/notes", "host": ["{{baseUrl}}"], "path": ["customers", ":id", "notes"] }
          }
        }
      ]
    },
    {
      "name": "3. Products & Catalog",
      "item": [
        {
          "name": "List Products (Search & Low Stock)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/products?low_stock=true", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{"key":"low_stock","value":"true"}] }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sony Noise Cancelling Headphones\",\n  \"sku\": \"AUD-SON-WH1000\",\n  \"category\": \"Audio\",\n  \"unit_price\": 24990.00,\n  \"current_stock\": 15,\n  \"min_stock_alert\": 5,\n  \"location\": \"Warehouse A - Bay 4\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        }
      ]
    },
    {
      "name": "4. Inventory & Movements",
      "item": [
        {
          "name": "Get Inventory Overview & Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/inventory", "host": ["{{baseUrl}}"], "path": ["inventory"] }
          }
        },
        {
          "name": "Get Stock Movement Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/inventory/movements?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["inventory", "movements"] }
          }
        },
        {
          "name": "Manual Stock Adjustment (IN/OUT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"<PRODUCT_UUID>\",\n  \"quantity\": 10,\n  \"movement_type\": \"IN\",\n  \"reason\": \"Factory direct shipment received\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/inventory/adjust", "host": ["{{baseUrl}}"], "path": ["inventory", "adjust"] }
          }
        }
      ]
    },
    {
      "name": "5. Sales Challans",
      "item": [
        {
          "name": "List Sales Challans",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/challans", "host": ["{{baseUrl}}"], "path": ["challans"] }
          }
        },
        {
          "name": "Create Sales Challan (DRAFT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"<CUSTOMER_UUID>\",\n  \"items\": [\n    {\n      \"product_id\": \"<PRODUCT_UUID>\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/challans", "host": ["{{baseUrl}}"], "path": ["challans"] }
          }
        },
        {
          "name": "Confirm Sales Challan (Transactional Stock Deduction)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/challans/:id/confirm", "host": ["{{baseUrl}}"], "path": ["challans", ":id", "confirm"] }
          }
        },
        {
          "name": "Cancel Sales Challan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/challans/:id/cancel", "host": ["{{baseUrl}}"], "path": ["challans", ":id", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "6. Dashboard",
      "item": [
        {
          "name": "Get Dashboard Operational Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard", "host": ["{{baseUrl}}"], "path": ["dashboard"] }
          }
        }
      ]
    }
  ]
}
